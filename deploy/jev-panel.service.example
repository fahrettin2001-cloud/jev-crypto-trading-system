[Unit]
Description=Jev local read-only paper portfolio panel
After=network.target

[Service]
User=jev
Group=jev
WorkingDirectory=/opt/jev
ExecStart=/opt/jev/.venv/bin/python -m jev.web --db /var/lib/jev/paper.db --port 8765
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jev

[Install]
WantedBy=multi-user.target
