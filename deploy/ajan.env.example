# /etc/jev/ajan.env olarak kopyalayin: sahip root:root, izin 600. Depoya EKLEMEYIN.
# Yalnizca kullandiginiz saglayicinin anahtarini doldurun.

# --- Model saglayicisi (biri yeterli) ---
TRADINGAGENTS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Dusuk maliyet (16 Kasim 2026): iki katman da Haiku 5.5.
# Sonnet ile 2 coin x 3 analist gecede ~1,66 USD tuttu. Kaliteyi artirmak icin
# derin katman (yoneticiler) claude-sonnet-5-5 yapilabilir.
# TradingAgents v0.7.1 listesinde olmadigi icin "unknown model" uyarisi verir, calisir.
TRADINGAGENTS_QUICK_THINK_LLM=claude-haiku-5-5
TRADINGAGENTS_DEEP_THINK_LLM=claude-haiku-5-5
# Alternatif: TRADINGAGENTS_LLM_PROVIDER=openai + OPENAI_API_KEY=...

# Tartisma turlari (maliyeti dogrudan artirir; 1 onerilir)
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_LLM_MAX_RETRIES=4
# Analist basina veri cekme turu (varsayilan 20); maliyeti sinirlar
TRADINGAGENTS_MAX_TOOL_ROUNDS=8

# --- Jev: yalnizca duygu analisti (social) aciksa kullanilir; varsayilan kapali. ---
# /etc/jev/typesafe.env (jev-golge-kur.sh) varsa otomatik okunur. Yoksa: ---
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# --- Istege bagli, ucretsiz: haber analisti icin makro veri (faiz, enflasyon) ---
# https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=
