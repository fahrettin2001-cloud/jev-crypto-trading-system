[Unit]
Description=Jev trend toplulugu - ikinci SANAL hesap, gunluk mum (gercek emir yok)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jev
Group=jev
WorkingDirectory=/opt/jev/app
ExecStart=/usr/bin/python3 -m jev.live run --dir /var/lib/jev/trend --catchup 5
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jev/trend
